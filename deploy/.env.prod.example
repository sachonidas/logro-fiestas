# Copia este fichero a .env.prod en la RAÍZ del repo clonado en el VPS
# (/opt/logro-fiestas/.env.prod). docker compose lo usa para interpolar
# docker-compose.prod.yml: docker compose --env-file .env.prod -f ...

# Contraseña de Postgres. DATABASE_URL se compone en docker-compose.prod.yml.
# Genera una: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# Clave que protege POST /api/events/load y DELETE /api/events (x-api-key).
# Es la que usa data/load.sh. Genera otra distinta: openssl rand -hex 32
API_KEY=CHANGE_ME

# El dominio (api.fiestaslogrono.es) NO se configura aquí: vive en el vhost del
# Caddyfile de cooking-athletes, que es quien termina TLS. Ver docs/deploy.md §2.
